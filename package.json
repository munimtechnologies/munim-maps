{
  "name": "munim-maps-root",
  "private": true,
  "workspaces": [
    "packages/*",
    "example"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/munimtechnologies/munim-maps.git"
  },
  "scripts": {
    "build": "npm --workspace munim-maps run build",
    "codegen": "npm --workspace munim-maps run codegen",
    "lint": "npm --workspace munim-maps run lint-ci",
    "typecheck": "npm --workspace munim-maps run typecheck",
    "test": "npm --workspace munim-maps run test",
    "typecheck:example": "tsc --noEmit -p example/tsconfig.json",
    "check": "npm run codegen && npm run lint && npm run typecheck && npm test && npm run typecheck:example && npm run build && npm run check:vehicles && npm run check:cesium && npm run check:maplibre && npm run pack:dry-run",
    "pack:dry-run": "npm --workspace munim-maps pack --dry-run && npm --workspace munim-maps-vehicles pack --dry-run",
    "example:start": "npm --workspace example run start",
    "example:ios": "npm --workspace example run ios",
    "example:android": "npm --workspace example run android",
    "check:vehicles": "npm --workspace munim-maps-vehicles run check",
    "check:cesium": "node scripts/cesium/check-version.mjs",
    "check:maplibre": "node scripts/maplibre/check-version.mjs",
    "vehicles:catalogue": "node scripts/vehicles/write-catalogue.mjs",
    "release": "semantic-release",
    "release:local": "node scripts/release-local.mjs"
  },
  "devDependencies": {
    "@semantic-release/git": "^11.0.1",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "semantic-release": "^26.0.1"
  },
  "overrides": {
    "@semantic-release/npm": {
      "npm": "npm:@semantic-release/error@4.0.0"
    }
  }
}
