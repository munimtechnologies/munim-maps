{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": [
    "munimmaps"
  ],
  "ios": {
    "iosModuleName": "NitroMunimMaps"
  },
  "android": {
    "androidNamespace": [
      "munimmaps"
    ],
    "androidCxxLibName": "NitroMunimMaps"
  },
  "autolinking": {
    "MapModelLayer": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridMapModelLayer"
      }
    },
    "MunimMapView": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridMunimMapView"
      }
    },
    "MunimTerrain": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridMunimTerrain"
      }
    },
    "MapControl": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridMapControl"
      }
    }
  },
  "ignorePaths": [
    "**/node_modules"
  ]
}
